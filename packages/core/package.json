{
	"name": "@meng-xi/create-uni-app",
	"type": "commonjs",
	"version": "1.0.0",
	"private": false,
	"description": "基于 uni-app 的交互式脚手架 CLI，按需生成 uni-app 基础项目与可选功能",
	"keywords": [
		"@meng-xi/create-uni-app",
		"meng-xi",
		"create-uni-app",
		"uni-app",
		"cli"
	],
	"main": "dist/index.js",
	"bin": {
		"create-uni-app": "dist/index.js"
	},
	"files": [
		"dist",
		"templates",
		"README.md"
	],
	"scripts": {
		"dev": "tsc -p tsconfig.json && node dist/index.js --help",
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"commander": "^11.1.0",
		"module-alias": "^2.2.3",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/prompts": "^2.4.9",
		"typescript": "^5.5.0"
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"author": {
		"name": "PedroQue99",
		"email": "ksmengfang@163.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/MengXi-Studio/create-uni-app#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MengXi-Studio/create-uni-app.git"
	},
	"bugs": "https://github.com/MengXi-Studio/create-uni-app/issues"
}
